# Get from: https://ollama.com/settings/keys
OLLAMA_API_KEY=ollama_api_key_here
# Get from: https://modelscope.cn/my/myaccesstoken
# Skipped: can't sign up, too many errors and unclear verification step
MODELSCOPE_API_KEY=modelscope_api_key_here
# Get from: https://z.ai/model-api (international platform — NOT open.bigmodel.cn, which needs a China phone number to register)
# Get from: https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=zai_api_key_here
# Get from: https://cloud.siliconflow.com/ (international platform — NOT cloud.siliconflow.cn, same phone-verification issue)
# Get from: https://cloud.siliconflow.com/me/account/ak
SILICONFLOW_API_KEY=siliconflow_api_key_here
# Get from: https://www.aionlabs.ai/accounts/signup/ (create an account, then generate the key from your dashboard)
# Get from: https://www.aionlabs.ai/app/api-keys/
AIONLABS_API_KEY=aionlabs_api_key_here
# Get from: https://chutes.ai/app (sign in, then create a key from account/developer settings)
CHUTES_API_KEY=chutes_api_key_here
# Get from: https://token.llm7.io/
# Get from: https://token.llm7.io/#/api-keys
LLM7_API_KEY=llm7_api_key_here
# Get from: https://platform.inceptionlabs.ai/dashboard/api-keys
# Diffusion LLM (Mercury Coder) — OpenAI-compatible endpoint. Only needed for
# the diffusion adherence/continuity trial (docs/roadmap/AI_DIFFUSION_TOKEN_SAVING_EXECUTION_ROADMAP).
# Pricing is unconfirmed while Inception runs an API-credits burn campaign.
INCEPTION_API_KEY=inception_api_key_here

# Get from: https://console.neon.tech/app/projects/broad-dust-07944744?database=neondb
# Example: DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=postgresql://primary...
DATABASE_READ_URL=postgres://replica...
DATABASE_LOGGING=true

# Get from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_API_KEY_PUBLIC=imagekit_api_key_public_here
IMAGEKIT_API_KEY_PRIVATE=imagekit_api_key_private_here
IMAGEKIT_URL_ENDPOINT=imagekit_url_endpoint_here

# Get from: https://upstash.com → Create a free Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Portal forum queue (Upstash QStash → portal.twistloom.com)
# Console: https://console.upstash.com/qstash
# Destination is set per publish: {PORTAL_URL}/forum/api/queue/consume
QSTASH_TOKEN=
# Origin only (no path). Default production portal host.
PORTAL_URL=https://portal.twistloom.com
# Optional topic name (default twistloom.forum)
# QSTASH_FORUM_TOPIC=twistloom.forum

# Google OAuth - Required for Google One Tap Sign-In and OAuth authentication
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 credentials → Web application
# Add authorized redirect URIs (e.g., http://localhost:3001/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Service (Resend) - Required for password reset and email verification
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@twistloom.com
# Optional: team inbox for new user feedback alerts
# FEEDBACK_INBOX=ops@twistloom.com
# Optional: HMAC secret for email unsubscribe tokens (falls back to NEXTAUTH_SECRET)
# EMAIL_UNSUBSCRIBE_SECRET=your_unsubscribe_secret_here
# Legacy alias fallback for the above (kept for older setups); AUTH_SECRET is preferred.
# NEXTAUTH_SECRET=

# Stripe
# Get from: https://dashboard.stripe.com/acct_1TSpFoFmDKrMqBDf/test/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/acct_1TSpFoFmDKrMqBDf/test/workbench/webhooks/we_1TSpnnFmDKrMqBDfiLH29ofk?fromWizard=true
STRIPE_WEBHOOK_SECRET=whsec_...
# VIP subscription Price / Product IDs (Stripe Dashboard → Products)
# STRIPE_VIP_PRICE_ID=price_...
# STRIPE_VIP_PRODUCT_ID=prod_...

# ========================================
# Xendit (Indonesia local payments — credit packs v1)
# ========================================
# Dashboard: https://dashboard.xendit.co
# Docs: https://developers.xendit.co/api-reference/
#
# 1. Create/login at https://dashboard.xendit.co
# 2. Switch to Test mode for local dev
# 3. API Keys: Settings → Developers → API Keys → copy Secret Key (xnd_development_... / xnd_production_...)
#
# Get from: https://dashboard.xendit.co/settings/developers#api-keys
XENDIT_SECRET_KEY=xnd_development_...
#
# 4. Webhook / Callback token: Settings → Developers → Callbacks
#    - Copy "Callback verification token" (or "Webhook verification token")
#    - Set Invoice paid callback URL to:
#      https://<your-backend>/api/payments/xendit/webhook
#    Header verified: x-callback-token
XENDIT_WEBHOOK_TOKEN=your_xendit_callback_token_here
#
# Master switch: set true only when keys are configured and you want Xendit checkout live.
# When false (default), GET/POST credit-pack Xendit paths reject with validation error.
XENDIT_ENABLED=false
#
# Fixed USD→IDR rate for reference / future FX display (update periodically).
# Pack IDR prices live in src/config/xendit.ts (not computed from this rate at runtime).
XENDIT_USD_TO_IDR_RATE=15500

# GitHub
# Get from: https://github.com/settings/personal-access-tokens
GITHUB_WORKFLOW_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=txufiknr
GITHUB_REPO_NAME=Twistloom-backend
GITHUB_DEFAULT_BRANCH=main

# System User ID - Required for cron jobs (generate-originals, cleanup)
# This is the user ID under which system-generated content is created
# Get from: `bun db:reset` (look for "Created Admin user")
SYSTEM_USER_ID=system_user_id_here

# Seed accounts - created by db/triggers.ts.

# Root admin / system account - created as the very first user row only when
# the users table is empty (username/password configurable via env).
SYSTEM_USER_USERNAME=twistloom
# Password for logging into the root admin account (enables email/password login)
SYSTEM_USER_PASSWORD=your_system_password_here

# Demo end-user account - OPT-IN. Only created (idempotently by username) when
# DEMO_USERNAME is configured; skipped entirely otherwise. Username is the
# identity key, so the account is only ever seeded once.
DEMO_USERNAME=demo
# Unique email for the demo account (must differ from the admin email)
DEMO_EMAIL=demo@twistloom.com
# Password for logging into the demo account (enables email/password login)
DEMO_USER_PASSWORD=your_demo_password_here

# Demo User ID - Required for the demo account to always get 0 credit cost
# (every credit action is free for this user, as if FEATURE_FREE_DEMO=true,
# regardless of the global flag). Uses `applyFreeDemoPricing`/per-user cost
# helpers in src/config/credits.ts + src/services/credits.ts.
# Set BEFORE the first `bun db:triggers` run to fix the demo user's id on seed;
# otherwise copy it from the demo user's userId printed on creation (look for
# "Created demo user").
DEMO_USER_ID=demo_user_id_here

# ========================================
# On-demand cron triggers (Optional)
# ========================================
# These switch cron jobs from their scheduled "batch" mode into a targeted,
# single-item mode. Useful for debugging or backfilling one specific item.

# retry-pending-generations: when both TRIGGERED_BOOK_ID and TRIGGERED_PAGE_ID are
# set, the job processes just that page instead of the pending queue.
# TRIGGERED_BOOK_ID=
# TRIGGERED_PAGE_ID=
# TRIGGERED_BY_USER=      # Optional: userId to attribute the regeneration to
# TRIGGERED_MAX_DEPTH=    # Optional: cap branching pre-generation depth

# on-demand-book-creation: when set, the job processes just this book instead of
# the hourly pending-book routine. (Used by POST /api/books async workflow.)
# BOOK_ID=

# Vercel Environment Variables (Required for Hobby tier solution)
# VERCEL_URL: Your Vercel deployment URL (auto-set by Vercel)
# Usage: Used by main route to call background function internally
VERCEL_URL=https://twistloom-backend.vercel.app

# Vercel Cron security
# Generate from: openssl rand -hex 32
CRON_SECRET=your-secret-key

# ========================================
# Fluid Active CPU optimization master switch (Vercel Hobby / CPU-constrained tiers)
# ========================================
# All CPU-saving refactors (status-poll coalescing, session-verify cache, and
# status-payload compression skip) are gated behind this single flag, defined in
# src/config/cpu-optimizations.ts.
#
# - Unset / "false" (DEFAULT on Hobby): optimizations ON. Minimizes Fluid Active
#   CPU so the 4 CPU-hour/month Hobby quota is not exceeded.
# - "true" (or 1 / yes / on) — use on Vercel Pro / pay-as-you-go where CPU is no
#   longer a constraint: disables all three optimizations, restoring maximum data
#   freshness (no coalescing staleness) and removing the <=60s session-verify trust
#   window, at the cost of higher CPU. No code edits required to switch modes.
DISABLE_CPU_OPTIMIZATIONS=false


# Internal API Security (Required for fire-and-forget pattern)
# Generate from: openssl rand -base64 32
# Purpose: Secures internal API calls between routes
INTERNAL_SECRET=your-internal-secret-here

# Optional: Brave Search (social mentions)
BRAVE_SEARCH_API_KEY=

# Optional: extra comma-separated hostnames treated as Twistloom links when
# extracting story links from social mentions (in addition to FRONTEND_URL and
# the hardcoded production host). e.g. "stories.twistloom.com,staging.web.app"
# SOCIAL_MENTION_LINK_HOSTS=

# Feature Flags (Optional) - Enable/disable auth enhancements
FEATURE_PASSWORD_VALIDATION=true
FEATURE_ACCOUNT_LOCKOUT=true
FEATURE_PASSWORD_RESET=true
FEATURE_EMAIL_VERIFICATION=true

# Free demo phase: when true (default), all CREDIT_COSTS and book-mode credit
# costs are zero so the platform is free of charge. Set to false to enable paid pricing.
FEATURE_FREE_DEMO=true

# ========================================
# Voucher HMAC Key (Required for voucher redemption)
# ========================================
# Used to sign voucher codes with HMAC-SHA-256 so database-only attackers
# cannot validate candidate codes without the server secret.
# Generate with: openssl rand -base64 32
# IMPORTANT: Set a unique value per environment (dev/staging/production).
# Falls back to AUTH_SECRET / SESSION_SECRET if not set, but a dedicated key
# is recommended for cryptographic isolation.
VOUCHER_HMAC_KEY=your_voucher_hmac_key_here

# Required for Vercel API
# Set in: https://vercel.com/txufiknrs-projects/twistloom-backend/settings/environment-variables
# - NODE_ENV=production	       # Enables prod guards, disables debug logs
# - DATABASE_URL	           # Primary Neon DB (read/write)
# - DATABASE_READ_URL	       # Neon read replica
# - UPSTASH_REDIS_REST_URL	   # Rate limiting
# - UPSTASH_REDIS_REST_TOKEN   # Rate limiting
# - JINA_API_KEY	           # Embeddings (semantic memory)
# - GEMINI_API_KEY	           # Story writing
# - GITHUB_API_KEY	           # Story writing
# - MISTRAL_API_KEY	           # Story writing
# - COHERE_API_KEY	           # Story writing
# - CEREBRAS_API_KEY	       # Story writing
# - GROQ_API_KEY	           # Story writing
# - NVIDIA_API_KEY	           # Story writing
# - IMAGEKIT_API_KEY_PRIVATE   # Image storage
# - GITHUB_WORKFLOW_TOKEN      # Workflow runs
# - GITHUB_REPO_OWNER          # Workflow runs
# - GITHUB_REPO_NAME           # Workflow runs
# - GITHUB_DEFAULT_BRANCH      # Workflow runs
# - CRON_SECRET                # Cron security
# - INTERNAL_SECRET            # Webhook/Internal API

# Required for GitHub Actions
# Set in: https://github.com/txufiknr/Twistloom-backend/settings/secrets/actions
# - DATABASE_URL	           # Primary Neon DB (read/write)
# - DATABASE_READ_URL	       # Read cron queue table
# - SYSTEM_USER_ID	           # System user for cron jobs
# - JINA_API_KEY	           # Embeddings (semantic memory)
# - GEMINI_API_KEY	           # Story writing
# - GITHUB_API_KEY	           # Story writing
# - MISTRAL_API_KEY	           # Story writing
# - COHERE_API_KEY	           # Story writing
# - CEREBRAS_API_KEY	       # Story writing
# - GROQ_API_KEY	           # Story writing
# - NVIDIA_API_KEY	           # Story writing
# - IMAGEKIT_API_KEY_PRIVATE   # Image deletion cron

# These should never go to production:
# - DATABASE_LOGGING=true
# - PORT=3000

# ========================================
# Performance Monitoring (src/services/performance-monitoring.ts)
# ========================================
# Master switch for the in-process performance metrics collector (reconstruction
# timing, target-violation warnings, periodic in-memory cleanup interval).
# - Unset / "false" (DEFAULT): monitoring ON. Metrics are recorded per request.
# - "true" (or 1 / yes / on): monitoring OFF. startPerformanceMeasurement returns
#   a no-op, nothing is recorded, and the cleanup setInterval is never scheduled
#   (important on Vercel serverless, where a lingering interval keeps the event
#   loop alive and prevents freeze/teardown).
DISABLE_PERFORMANCE_MONITORING=false

# ========================================
# VIP Free Trial
# ========================================

# Master kill-switch for the VIP free trial feature. When false (or unset),
# all trial endpoints reject requests and isTrialEligible() always returns
# false, regardless of any other state. Flip to true only once you've run
# through the test-clock scenarios in the roadmap's §6 Testing plan.
VIP_TRIAL_ENABLED=false

# Trial length in days. Stripe's trial_period_days is day-count based, not
# calendar-month based — 30 is the roadmap's recommendation (see §2).
VIP_TRIAL_PERIOD_DAYS=30

# What happens if the trial ends with no valid payment method on file.
# 'cancel'  — Stripe cancels the subscription immediately (current default,
#             simplest for v1 — see roadmap Q2).
# 'pause'   — Stripe pauses the subscription; the downgrade/notification path
#             needs additional work to handle a 'paused' status correctly
#             before this is safe to use. Do not set this to 'pause' without
#             revisiting VIP_FREE_TRIAL_ROADMAP.md §4.6 first.
VIP_TRIAL_END_BEHAVIOR=cancel

# ========================================
# VIP Benefits overrides (Optional)
# ========================================
# Defaults live in src/config/subscription.ts. Only set these to override.
# VIP_MONTHLY_CREDITS=200      # Monthly VIP credit grant (default 200)
# VIP_CHECKIN_MULTIPLIER=2     # Daily check-in multiplier for VIPs (default 2)

# ========================================
# Prompt Cache (Optional, src/config/prompt-cache.ts)
# ========================================
# The story theme prompt cache pre-generates & stores prompt templates to cut AI
# cost. All optional — the shipped defaults are used when unset.
# PROMPT_CACHE_ENABLED=false        # Master switch for the prompt cache
# PROMPT_CACHE_THRESHOLD=100        # Min cached prompts before cache is used
# PROMPT_CACHE_HIT_RATE=0.7         # Cache hit rate (0-1) for hybrid mode
# PROMPT_CACHE_TARGET_SIZE=500      # Target number of active cached prompts
# PROMPT_CACHE_MIN_QUALITY=0.7      # Min quality score (0-1) to save a prompt
# PROMPT_STREAM_CHUNK_SIZE=10       # Chars per chunk when simulating streaming
# PROMPT_STREAM_DELAY_MS=50         # Delay between stream chunks (ms)
# PROMPT_EXPIRE_DEFAULT=90          # Default cache expiry (days)
# PROMPT_EXPIRE_HIGH_QUALITY=180    # Expiry for high-quality prompts (>=0.9)
# PROMPT_EXPIRE_LOW_QUALITY=30      # Expiry for low-quality prompts (<0.7)
# PROMPT_GENERATION_CRON='0 2 * * 0'  # Weekly prompt generation schedule
# PROMPT_CLEANUP_CRON='0 3 * * *'     # Daily prompt cache cleanup schedule
# PROMPT_BATCH_SIZE=10              # Batch size for weekly generation
# PROMPT_MAX_USAGE_COUNT=100        # Max usage count before retiring a prompt
