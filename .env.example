# Local development environment variables
# Copy this file to .env.local and fill in your values
PORT=3000

# NextAuth v5 Configuration (Required for cookie-based authentication)
# Generate a random secret: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
AUTH_TRUST_HOST=true

# Optional: use Secure cookies during local development (default: false)
# Only set true if you run local HTTPS (e.g. localhost with a dev cert / localtunnel).
DEV_USE_SECURE_COOKIES=false

# Backend URL (Required for Webhook configuration and internal API calls)
BACKEND_URL=http://localhost:3000

# Frontend URL (Required for CORS with credentials)
# Local development: http://localhost:3001
# Production: https://twistloom-web.vercel.app
FRONTEND_URL=http://localhost:3001
FRONTEND_URL=https://localhost:3002

# Auth URL (Required for NextAuth cookie configuration)
# Should match your frontend domain exactly
AUTH_URL=http://localhost:3001
AUTH_URL=https://localhost:3002

# Auth Rate Limiting (Optional)
# Controls IP-based rate limiting for credential verification endpoints
# AUTH_RATE_LIMIT_MAX_ATTEMPTS: Maximum login attempts per window (default: 5)
# AUTH_RATE_LIMIT_WINDOW_MS: Time window in milliseconds (default: 60000 = 1 minute)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# AI Generation Rate Limits (Optional, heuristics from src/config/ai-rate-limits.ts)
# Per-user throttles on cost-amplifying AI endpoints. Each request can spin up
# expensive LLM calls, so these are stricter than the global 100 req/min cap.
# Sliding-window (Upstash Redis), keyed on the authenticated userId, fail-open
# without Redis. All are tunable via RLIST_MAX_<NAME> / RLIST_SECONDS_<NAME>.
# Backend executes multiple job branches for bot survival and applies per-user limits
# as the first line of defense against spend amplification + brute force.
# Syntax: RLIST_MAX_<NAME>=<max requests per window>, RLIST_SECONDS_<NAME>=<window sec>
# BOOK_CREATION (POST /api/books) ............ 5 requests / 60s
# BOOK_STREAM    (POST /api/books/stream) .... 10 requests / 60s
# BOOK_ASYNC     (POST /api/books/async) ..... 10 requests / 60s
# ACTION_HINT    (.../actions/hint) .......... 30 requests / 60s
# CUSTOM_ACTION_PREVIEW (.../custom-actions/preview) ... 20 requests / 60s
# CUSTOM_ACTION_SUBMIT  (.../custom-actions/submit)  ... 10 requests / 60s
# RLIST_MAX_BOOK_CREATION=5
# RLIST_SECONDS_BOOK_CREATION=60
# RLIST_MAX_BOOK_STREAM=10
# RLIST_SECONDS_BOOK_STREAM=60
# RLIST_MAX_BOOK_ASYNC=10
# RLIST_SECONDS_BOOK_ASYNC=60
# RLIST_MAX_ACTION_HINT=30
# RLIST_SECONDS_ACTION_HINT=60
# RLIST_MAX_CUSTOM_ACTION_PREVIEW=20
# RLIST_SECONDS_CUSTOM_ACTION_PREVIEW=60
# RLIST_MAX_CUSTOM_ACTION_SUBMIT=10
# RLIST_SECONDS_CUSTOM_ACTION_SUBMIT=60

# Get from: https://github.com/settings/tokens
GITHUB_API_KEY=github_api_key_here

# Get from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=gemini_api_key_here

# Get from: https://console.mistral.ai/home?profile_dialog=api-keys
# Get from: https://admin.mistral.ai/organization/api-keys
# Get from: https://admin.mistral.ai/organization/workspaces/d892d650-9c31-4f94-9a50-90e945acc967/api-keys
MISTRAL_API_KEY=mistral_api_key_here

# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=cohere_api_key_here

# Get from: https://cloud.cerebras.ai/platform/org_2ypxv2rc6j554f4f22pntket/apikeys
CEREBRAS_API_KEY=cerebras_api_key_here

# Get from: https://console.groq.com/keys
GROQ_API_KEY=groq_api_key_here

# Get from: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvidia_api_key_here

# Get from: https://jina.ai/embeddings (free tier: 100 RPM / 100K TPM / 2 concurrent)
# Used by pgvector semantic memory (embedding generation for past events, character
# interactions, place events, and future-note ranking — see Use Cases 1/2/3/5).
JINA_API_KEY=jina_api_key_here

# Get from: https://openrouter.ai/keys
# Get from: https://openrouter.ai/workspaces/twistloom/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from: https://dash.cloudflare.com/profile/api-tokens
