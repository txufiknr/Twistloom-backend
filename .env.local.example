# Local development environment variables
# Copy this file to .env.local and fill in your values
PORT=3000

# NextAuth v5 Configuration (Required for cookie-based authentication)
# Generate a random secret: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
AUTH_TRUST_HOST=true

# Backend URL (Required for Webhook configuration and internal API calls)
BACKEND_URL=http://localhost:3000

# Frontend URL (Required for CORS with credentials)
# Local development: http://localhost:3001
# Production: https://twistloom-web.vercel.app
FRONTEND_URL=http://localhost:3001
FRONTEND_URL=https://localhost:3002

# Auth URL (Required for NextAuth cookie configuration)
# Should match your frontend domain exactly
AUTH_URL=http://localhost:3001
AUTH_URL=https://localhost:3002

# Auth Rate Limiting (Optional)
# Controls IP-based rate limiting for credential verification endpoints
# AUTH_RATE_LIMIT_MAX_ATTEMPTS: Maximum login attempts per window (default: 5)
# AUTH_RATE_LIMIT_WINDOW_MS: Time window in milliseconds (default: 60000 = 1 minute)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Get from: https://github.com/settings/tokens
GITHUB_API_KEY=github_api_key_here

# Get from: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=gemini_api_key_here

# Get from: https://console.mistral.ai/home?profile_dialog=api-keys
MISTRAL_API_KEY=mistral_api_key_here

# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=cohere_api_key_here

# Get from: https://cloud.cerebras.ai/platform/org_2ypxv2rc6j554f4f22pntket/apikeys
CEREBRAS_API_KEY=cerebras_api_key_here

# Get from: https://console.groq.com/keys
GROQ_API_KEY=groq_api_key_here

# Get from: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvidia_api_key_here

# Get from: https://jina.ai/embeddings (free tier: 100 RPM / 100K TPM / 2 concurrent)
# Used by pgvector semantic memory (embedding generation for past events, character
# interactions, place events, and future-note ranking — see Use Cases 1/2/3/5).
JINA_API_KEY=jina_api_key_here

# Get from: https://openrouter.ai/keys
# Get from: https://openrouter.ai/workspaces/twistloom/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from: https://dash.cloudflare.com/profile/api-tokens
# Get the account ID from the Cloudflare dashboard URL (dash.cloudflare.com/<ACCOUNT_ID>)
# Create the API token under My Profile → API Tokens, scoped to Workers AI.
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Get from: https://console.neon.tech/app/projects/broad-dust-07944744?database=neondb
# Example: DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_URL=postgresql://primary...
DATABASE_READ_URL=postgres://replica...
DATABASE_LOGGING=true

# Get from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_API_KEY_PUBLIC=imagekit_api_key_public_here
IMAGEKIT_API_KEY_PRIVATE=imagekit_api_key_private_here
IMAGEKIT_URL_ENDPOINT=imagekit_url_endpoint_here

# Get from: https://upstash.com → Create a free Redis database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Portal forum queue (Upstash QStash → portal.twistloom.com)
# Console: https://console.upstash.com/qstash
# Destination is set per publish: {PORTAL_URL}/forum/api/queue/consume
QSTASH_TOKEN=
# Origin only (no path). Default production portal host.
PORTAL_URL=https://portal.twistloom.com
# Optional topic name (default twistloom.forum)
# QSTASH_FORUM_TOPIC=twistloom.forum

# Google OAuth - Required for Google One Tap Sign-In and OAuth authentication
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 credentials → Web application
# Add authorized redirect URIs (e.g., http://localhost:3001/api/auth/callback/google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Service (Resend) - Required for password reset and email verification
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@twistloom.com
# Optional: team inbox for new user feedback alerts
# FEEDBACK_INBOX=ops@twistloom.com
# Optional: HMAC secret for email unsubscribe tokens (falls back to NEXTAUTH_SECRET)
# EMAIL_UNSUBSCRIBE_SECRET=your_unsubscribe_secret_here

# Stripe
# Get from: https://dashboard.stripe.com/acct_1TSpFoFmDKrMqBDf/test/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/acct_1TSpFoFmDKrMqBDf/test/workbench/webhooks/we_1TSpnnFmDKrMqBDfiLH29ofk?fromWizard=true
STRIPE_WEBHOOK_SECRET=whsec_...
# VIP subscription Price / Product IDs (Stripe Dashboard → Products)
# STRIPE_VIP_PRICE_ID=price_...
# STRIPE_VIP_PRODUCT_ID=prod_...

# ========================================
# Xendit (Indonesia local payments — credit packs v1)
# ========================================
# Dashboard: https://dashboard.xendit.co
# Docs: https://developers.xendit.co/api-reference/
#
# 1. Create/login at https://dashboard.xendit.co
# 2. Switch to Test mode for local dev
# 3. API Keys: Settings → Developers → API Keys → copy Secret Key (xnd_development_... / xnd_production_...)
XENDIT_SECRET_KEY=xnd_development_...
#
# 4. Webhook / Callback token: Settings → Developers → Callbacks
#    - Copy "Callback verification token" (or "Webhook verification token")
#    - Set Invoice paid callback URL to:
#      https://<your-backend>/api/payments/xendit/webhook
#    Header verified: x-callback-token
XENDIT_WEBHOOK_TOKEN=your_xendit_callback_token_here
#
# Master switch: set true only when keys are configured and you want Xendit checkout live.
# When false (default), GET/POST credit-pack Xendit paths reject with validation error.
XENDIT_ENABLED=false
#
# Fixed USD→IDR rate for reference / future FX display (update periodically).
# Pack IDR prices live in src/config/xendit.ts (not computed from this rate at runtime).
XENDIT_USD_TO_IDR_RATE=15500

# GitHub
# Get from: https://github.com/settings/personal-access-tokens
GITHUB_WORKFLOW_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=txufiknr
GITHUB_REPO_NAME=Twistloom-backend
GITHUB_DEFAULT_BRANCH=main

# System User ID - Required for cron jobs (generate-originals, cleanup)
# This is the user ID under which system-generated content is created
# Get from: pnpm db:reset (look for "Created Admin user")
SYSTEM_USER_ID=system_user_id_here

# System User Password - for logging into the twistloom system admin account
# Used by createInitialAdminUser() in db/triggers.ts
SYSTEM_USER_PASSWORD=your_system_password_here

# Vercel Environment Variables (Required for Hobby tier solution)
# VERCEL_URL: Your Vercel deployment URL (auto-set by Vercel)
# Usage: Used by main route to call background function internally
VERCEL_URL=https://twistloom-backend.vercel.app

# Vercel Cron security
# Generate from: openssl rand -hex 32
CRON_SECRET=your-secret-key

# Internal API Security (Required for fire-and-forget pattern)
# Generate from: openssl rand -base64 32
# Purpose: Secures internal API calls between routes
INTERNAL_SECRET=your-internal-secret-here

# Optional: Brave Search (social mentions)
BRAVE_SEARCH_API_KEY=

# Feature Flags (Optional) - Enable/disable auth enhancements
FEATURE_PASSWORD_VALIDATION=true
FEATURE_ACCOUNT_LOCKOUT=true
FEATURE_PASSWORD_RESET=true
FEATURE_EMAIL_VERIFICATION=true

# Free demo phase: when true (default), all CREDIT_COSTS and book-mode credit
# costs are zero so the platform is free of charge. Set to false to enable paid pricing.
FEATURE_FREE_DEMO=true

# Required for Vercel API
# Set in: https://vercel.com/txufiknrs-projects/twistloom-backend/settings/environment-variables
# - NODE_ENV=production	       # Enables prod guards, disables debug logs
# - DATABASE_URL	           # Primary Neon DB (read/write)
# - DATABASE_READ_URL	       # Neon read replica
# - UPSTASH_REDIS_REST_URL	   # Rate limiting
# - UPSTASH_REDIS_REST_TOKEN   # Rate limiting
# - JINA_API_KEY	           # Embeddings (semantic memory)
# - GEMINI_API_KEY	           # Story writing
# - GITHUB_API_KEY	           # Story writing
# - MISTRAL_API_KEY	           # Story writing
# - COHERE_API_KEY	           # Story writing
# - CEREBRAS_API_KEY	       # Story writing
# - GROQ_API_KEY	           # Story writing
# - NVIDIA_API_KEY	           # Story writing
# - IMAGEKIT_API_KEY_PRIVATE   # Image storage
# - GITHUB_WORKFLOW_TOKEN      # Workflow runs
# - GITHUB_REPO_OWNER          # Workflow runs
# - GITHUB_REPO_NAME           # Workflow runs
# - GITHUB_DEFAULT_BRANCH      # Workflow runs
# - CRON_SECRET                # Cron security
# - INTERNAL_SECRET            # Webhook/Internal API

# Required for GitHub Actions
# Set in: https://github.com/txufiknr/Twistloom-backend/settings/secrets/actions
# - DATABASE_URL	           # Primary Neon DB (read/write)
# - DATABASE_READ_URL	       # Read cron queue table
# - SYSTEM_USER_ID	           # System user for cron jobs
# - JINA_API_KEY	           # Embeddings (semantic memory)
# - GEMINI_API_KEY	           # Story writing
# - GITHUB_API_KEY	           # Story writing
# - MISTRAL_API_KEY	           # Story writing
# - COHERE_API_KEY	           # Story writing
# - CEREBRAS_API_KEY	       # Story writing
# - GROQ_API_KEY	           # Story writing
# - NVIDIA_API_KEY	           # Story writing
# - IMAGEKIT_API_KEY_PRIVATE   # Image deletion cron

# These should never go to production:
# - DATABASE_LOGGING=true
# - PORT=3000

# ========================================
# VIP Free Trial
# ========================================

# Master kill-switch for the VIP free trial feature. When false (or unset),
# all trial endpoints reject requests and isTrialEligible() always returns
# false, regardless of any other state. Flip to true only once you've run
# through the test-clock scenarios in the roadmap's §6 Testing plan.
VIP_TRIAL_ENABLED=false

# Trial length in days. Stripe's trial_period_days is day-count based, not
# calendar-month based — 30 is the roadmap's recommendation (see §2).
VIP_TRIAL_PERIOD_DAYS=30

# What happens if the trial ends with no valid payment method on file.
# 'cancel'  — Stripe cancels the subscription immediately (current default,
#             simplest for v1 — see roadmap Q2).
# 'pause'   — Stripe pauses the subscription; the downgrade/notification path
#             needs additional work to handle a 'paused' status correctly
#             before this is safe to use. Do not set this to 'pause' without
#             revisiting VIP_FREE_TRIAL_ROADMAP.md §4.6 first.
VIP_TRIAL_END_BEHAVIOR=cancel
