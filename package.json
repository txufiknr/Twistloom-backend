{
  "name": "twistloom-backend",
  "version": "1.0.0",
  "description": "Backend for Twistloom application",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/server.ts",
    "dev:api": "tsx --env-file=.env.local src/server.ts",
    "start": "node dist/server.js",
    "start:api": "node dist/server.js",
    "build": "node ./scripts/build.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:fast": "eslint . --rule '@typescript-eslint/no-floating-promises: off'",
    "lint:imports": "node ./scripts/check-import-extensions.js",
    "check": "pnpm lint && pnpm lint:imports && pnpm typecheck",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "tsx --env-file=.env.production node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "tsx node_modules/drizzle-kit/bin.cjs studio",
    "db:test": "tsx --env-file=.env.local src/db/test-connection.ts",
    "db:extensions": "tsx --env-file=.env.local src/db/extensions.ts",
    "db:extensions:prod": "tsx --env-file=.env.production src/db/extensions.ts",
    "db:triggers": "tsx --env-file=.env.local src/db/triggers.ts",
    "db:triggers:prod": "tsx --env-file=.env.production src/db/triggers.ts",
    "db:clear": "tsx --env-file=.env.local src/db/reset.ts",
    "db:clear:prod": "tsx --env-file=.env.production src/db/reset.ts",
    "db:reset": "pnpm db:clear && pnpm db:extensions && pnpm db:migrate && pnpm db:triggers",
    "db:reset:prod": "pnpm db:clear:prod && pnpm db:extensions:prod && pnpm db:migrate:prod && pnpm db:triggers:prod",
    "dev:cron:trending": "tsx --env-file=.env.local src/cron/update-trending-scores.ts",
    "dev:cron:generate": "tsx --env-file=.env.local src/cron/generate-originals.ts",
    "dev:cron:candidate": "tsx --env-file=.env.local src/cron/retry-pending-generations.ts",
    "dev:cron:translate": "tsx --env-file=.env.local src/cron/auto-translate-indonesian.ts",
    "dev:cron:vip-expiration": "tsx --env-file=.env.local src/cron/vip-expiration.ts",
    "dev:cron:cleanup": "tsx --env-file=.env.local src/cron/cleanup.ts",
    "start:cron:trending": "node dist/cron/update-trending-scores.js",
    "start:cron:generate": "node dist/cron/generate-originals.js",
    "start:cron:candidate": "node dist/cron/retry-pending-generations.js",
    "start:cron:translate": "node dist/cron/auto-translate-indonesian.js",
    "start:cron:vip-expiration": "node dist/cron/vip-expiration.js",
    "start:cron:cleanup": "node dist/cron/cleanup.js"
  },
  "author": {
    "name": "Taufik Nur Rahmanda",
    "email": "flias.test@gmail.com",
    "url": "https://txufiknr.pages.dev"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@apidevtools/json-schema-ref-parser": "^15.3.5",
    "@auth/express": "^0.12.2",
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "@google/genai": "^2.7.0",
    "@imagekit/nodejs": "^7.6.2",
    "@isdk/json-repair": "^0.1.2",
    "@mistralai/mistralai": "^2.2.5",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcrypt": "^6.0.0",
    "cohere-ai": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "groq-sdk": "^1.2.1",
    "jsonrepair": "^3.14.0",
    "lru-cache": "^11.5.1",
    "multer": "^2.1.1",
    "openai": "^6.39.1",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "tempmail-checker": "^1.1.1",
    "ua-parser-js": "^2.0.10",
    "undici": "^8.3.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
