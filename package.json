{
  "name": "twistloom-backend",
  "version": "1.0.0",
  "description": "Backend for Twistloom application",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "bun --watch src/server.bun.ts",
    "dev:api": "bun src/server.bun.ts",
    "start": "bun src/server.bun.ts",
    "build": "bun ./scripts/build.js",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint .",
    "lint:fix": "bunx eslint . --fix",
    "lint:fast": "bunx eslint . --rule '@typescript-eslint/no-floating-promises: off'",
    "lint:imports": "bun --env-file=.env.local ./scripts/check-import-extensions.js",
    "check": "bun run lint && bun run lint:imports && bun run typecheck",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:prod": "node --env-file=.env.production node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:test": "bun --env-file=.env.local src/db/test-connection.ts",
    "db:extensions": "bun --env-file=.env.local src/db/extensions.ts",
    "db:extensions:prod": "bun --env-file=.env.production src/db/extensions.ts",
    "db:triggers": "bun --env-file=.env.local src/db/triggers.ts",
    "db:triggers:prod": "bun --env-file=.env.production src/db/triggers.ts",
    "db:clear": "bun --env-file=.env.local src/db/reset.ts",
    "db:clear:prod": "bun --env-file=.env.production src/db/reset.ts",
    "db:reset": "bun run db:clear && bun run db:extensions && bun run db:migrate && bun run db:triggers",
    "db:reset:prod": "bun run db:clear:prod && bun run db:extensions:prod && bun run db:migrate:prod && bun run db:triggers:prod",
    "dev:cron:trending": "bun --env-file=.env.local src/cron/update-trending-scores.ts",
    "dev:cron:generate": "bun --env-file=.env.local src/cron/generate-originals.ts",
    "dev:cron:candidate": "bun --env-file=.env.local src/cron/retry-pending-generations.ts",
    "dev:cron:translate": "bun --env-file=.env.local src/cron/auto-translate-indonesian.ts",
    "dev:cron:vip-expiration": "bun --env-file=.env.local src/cron/vip-expiration.ts",
    "dev:cron:forum-ban": "bun --env-file=.env.local src/cron/forum-ban-reconciliation.ts",
    "dev:cron:cleanup": "bun --env-file=.env.local src/cron/cleanup.ts",
    "dev:cron:email-weekly": "bun --env-file=.env.local src/cron/email-weekly-recommendations.ts",
    "dev:cron:email-monthly": "bun --env-file=.env.local src/cron/email-monthly-summary.ts",
    "dev:usage-cache-report": "bun --env-file=.env.local src/cron/usage-cache-report.ts",
    "start:cron:trending": "bun dist/cron/update-trending-scores.js",
    "start:cron:generate": "bun dist/cron/generate-originals.js",
    "start:cron:candidate": "bun dist/cron/retry-pending-generations.js",
    "start:cron:translate": "bun dist/cron/auto-translate-indonesian.js",
    "start:cron:vip-expiration": "bun dist/cron/vip-expiration.js",
    "start:cron:forum-ban": "bun dist/cron/forum-ban-reconciliation.js",
    "start:cron:cleanup": "bun dist/cron/cleanup.js",
    "start:cron:email-weekly": "bun dist/cron/email-weekly-recommendations.js",
    "start:cron:email-monthly": "bun dist/cron/email-monthly-summary.js"
  },
  "author": {
    "name": "Taufik Nur Rahmanda",
    "email": "flias.test@gmail.com",
    "url": "https://txufiknr.pages.dev"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@apidevtools/json-schema-ref-parser": "^15.5.2",
    "@cerebras/cerebras_cloud_sdk": "^1.91.0",
    "@google/genai": "^2.17.1",
    "@hono/auth-js": "^1.1.1",
    "@isdk/json-repair": "^0.1.2",
    "@mistralai/mistralai": "^2.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "bcryptjs": "^2.4.3",
    "cohere-ai": "^8.0.0",
    "drizzle-orm": "0.45.2",
    "franc": "^6.2.0",
    "google-auth-library": "^10.9.1",
    "groq-sdk": "^1.5.0",
    "hono": "^4.13.2",
    "jsonrepair": "^3.15.0",
    "lru-cache": "^11.5.2",
    "openai": "^6.49.0",
    "resend": "^6.20.0",
    "stripe": "^22.5.0",
    "tempmail-checker": "^1.1.3",
    "ua-parser-js": "^2.0.10",
    "ultrahtml": "^1.7.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
